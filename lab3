a,b = random.randint(-10,10), random.randint(-10,10)
print('a:', a, ', b: ',b)
if a < b:
    k=a-1
else:
    k=b-1

def f(a,b,k):
    if a < b:
        if k < b:
            k+=1
            return k, f(a,b,k)
        else:
            return b
    else:
        if k < a:
            k+=1
            return k, f(a,b,k)
        else:
            return a
print(f(a,b,k))


