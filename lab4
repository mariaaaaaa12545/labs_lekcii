a = [[random.randint(5, 61) for b in range(5)]for i in range (4)]

def m(a):
    if len(a) <= 1:
        return a
    x = a[0][0]
    minn = [i for i in a if i[0] < x]
    maxx = [i for i in a if i[0] > x]
    return m(minn) + [a[0]] + m(maxx)

print(m(a))

