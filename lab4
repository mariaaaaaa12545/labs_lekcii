import random
#1, 2
a = [random.randint(50,100) for x in range(20)]
b = [random.randint(1,1000) for x in range(1000)]

def y(a):
    if len(a)<=1:
        return a
    x = a[0]
    minn, maxx = [i for i in a if i<x], [i for i in a if i>x]
    return y(minn)+[x]+y(maxx)

print(y(a), y(b))


